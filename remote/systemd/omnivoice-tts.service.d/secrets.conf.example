# Drop-in de SEGREDO — não versionar o valor (#348).
#
# Copie para `/etc/systemd/system/omnivoice-tts.service.d/secrets.conf` (0600,
# root) e preencha. Sem a chave o processo NÃO sobe (política fail-closed em
# `remote/auth_policy.py`), a não ser com `OMNI_ALLOW_NO_AUTH=1`.
#
#   sudo install -m 600 /dev/null /etc/systemd/system/omnivoice-tts.service.d/secrets.conf
#   sudo editor /etc/systemd/system/omnivoice-tts.service.d/secrets.conf
#   sudo systemctl daemon-reload && sudo systemctl restart omnivoice-tts
#   ./remote/deploy.sh smoke <host>       # 200 com "auth":"required"
#
# `deploy.sh recon` mostra `Environment=` com o valor REDIGIDO (`OMNI_API_KEY=<len
# 32>`): dá para conferir presença e tamanho sem vazar a chave no chat.
[Service]
Environment=OMNI_API_KEY=TROQUE-AQUI
# STT externo (Voxtral) não usa o Whisper daqui: OMNI_LOAD_WHISPER=0 libera VRAM.
# Environment=OMNI_LOAD_WHISPER=0
