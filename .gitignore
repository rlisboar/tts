# segredos e dados pessoais — NUNCA versionar
.apikey
.apikeys.json
.speaker-profiles.json
client/config.json
# a barra só casa DIRETÓRIO; num worktree `voices`/`.venv-mlx` são SYMLINK e
# escapavam do ignore (o `cf52376` chegou a commitá-los). Forma ANCORADA e sem
# barra: casa o link na raiz e não sombreia pasta de mesmo nome mais fundo (#685)
/voices
/outputs

# ambientes e modelos (instalados/baixados sob demanda)
.venv/
/.venv-mlx
# venv de teste do requirements.lock (task #29) e caches dele
.venv-locktest/
.tmp-lock/
.venv-omni/
.omnivoice-bf16/
__pycache__/
*.pyc

# estado de runtime (regenerado a partir dos defaults em app.py)
settings.json
# backups de recuperação gerados quando o load encontra JSON corrompido
*.corrupt

# artefatos de PoC / teste
poc-*.wav

# telemetria do onnxruntime: o ID do dispositivo é gravado em $HOME; quando o
# HOME não é gravável (sandbox/CI) a lib cai para um arquivo ":memory:.ses" no
# CWD. Regenerado a cada import — inofensivo, mas não é para versionar.
# (run.sh exporta ORT_DISABLE_TELEMETRY=1, que evita o arquivo e o warning.)
:memory:.ses

# log de runtime do servidor
server.log

# rascunho do navegador de teste (screenshots ficam em evidence/, que é versionado)
.playwright-mcp/

# config local do runner de agentes (pode conter credenciais) — nunca versionar
.grok/

# estado de operação gerado em runtime: histórico do /api/metrics (JSONL por dia,
# podado por TTL). Metadado de máquina, não se versiona (#376).
/state
# estado local de worktree/cópia (#721): nunca o do dono
.state-local/

# rascunhos locais: backups de probes e artefatos avulsos de sessão (o que
# importa vira evidence/ ou teste versionado)
tmp/
# log de sonda local (ex.: rodar a suíte em container para medir o CI)
.ci-probe.log

# artefatos de cobertura (pytest-cov)
.coverage
.coverage.*
htmlcov/

# PESOS ficam FORA do git — regra por EXTENSÃO, não por arquivo: assim peso novo
# de dono novo já nasce ignorado (o 84 MB do Demucs entrou como `*.th` não coberto
# e ficou a um `git add` de voltar ao histórico). O que fica rastreado ao lado deles
# é o manifesto (`models/sha256sums.txt`), `NOTICE`/`FONTE.txt`, configs (`*.yaml`,
# `*.json` pequenos) e `label_encoder.txt`; quem materializa é o
# `tools/baixa_modelos.sh`, conferindo sha256.
# `label_encoder.ckpt` é gerado pelo próprio speechbrain no primeiro load.
models/**/*.ckpt
models/**/*.pt
models/**/*.pth
models/**/*.th
models/**/*.safetensors
models/**/*.onnx
models/**/*.bin
models/**/*.whl
# config que vem junto do grafo do DFN3 (contrato do repositório): artefato igual
# ao `.onnx`, materializado pelo script — ver models/dfn3-onnx/NOTICE
models/dfn3-onnx/config.json
# pids da árvore do test_fila_suite_1130 (o teste roda com cwd no repo)
filho.pid
neto.pid
